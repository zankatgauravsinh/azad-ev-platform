model ServiceLabour {
  id           String      @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob  @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  labourItemId String?
  labourItem   LabourItem? @relation(fields: [labourItemId], references: [id])
  description  String
  cost         BigInt      @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceJobId])
}

model ServiceJobPhoto {
  id           String     @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  key          String
  caption      String?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([serviceJobId])
}

/// Standalone spare-parts inventory (distinct from sale Accessories). Stock is
/// decremented atomically when a part is added to a service job.
model SparePart {
  id             String @id @default(uuid())
  companyId      String @default("")
  name           String
  sku            String
  quantity       Int    @default(0)
  cost           BigInt @default(0)
  sellingPrice   BigInt @default(0)
  warrantyMonths Int    @default(0)
  minStock       Int    @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  usages ServicePart[]

  @@unique([companyId, sku])
  @@index([companyId])
  @@index([deletedAt])
}

/// Standard labour catalogue with editable default cost + duration.
model LabourItem {
  id           String @id @default(uuid())
  companyId    String @default("")
  name         String
  defaultCost  BigInt @default(0)
  durationMins Int    @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  usages ServiceLabour[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
}

// ─────────────────────────── System ───────────────────────────

model Notification {
  id         String               @id @default(uuid())
  companyId  String               @default("")
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority @default(MEDIUM)
  entityType String?
  entityId   String?
  /// Stable key for auto-generated notifications so refreshes don't duplicate them.
  dedupeKey  String?
  readAt     DateTime?
  archivedAt DateTime?
  expiresAt  DateTime?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, dedupeKey])
  @@index([companyId, readAt])
  @@index([companyId, type])
  @@index([companyId, priority])
  @@index([companyId, createdAt])
  @@index([expiresAt])
}

model ActivityLog {
  id         String         @id @default(uuid())
  companyId  String         @default("")
  actorId    String?
  actor      User?          @relation("ActivityLogActor", fields: [actorId], references: [id])
  action     ActivityAction
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([companyId])
}

/// The single source of truth for all configurable company behaviour.
/// One row per company; every module reads its settings from here.
model CompanySetting {
  id        String @id @default(uuid())
  companyId String @unique @default("")

  // Business
  businessName String  @default("AZAD EV POINT")
  legalName    String  @default("Azad Enterprise")
  dealerName   String?
  address      String?
  city         String  @default("Una, Gujarat")
  state        String  @default("Gujarat")
  phone        String?
  email        String?
  website      String?
  tagline      String  @default("POWERING TOMORROW")

  // Localization
  currency   String @default("INR")
  timezone   String @default("Asia/Kolkata")
  language   String @default("en")
  dateFormat String @default("DD/MM/YYYY")
  timeFormat String @default("12h")

  // GST / tax
  gstEnabled           Boolean                 @default(false)
  gstNumber            String?
  taxPercentage        Decimal                 @default(0) @db.Decimal(5, 2)
  // GST registration state code (place-of-supply basis for a future tax engine; config only).
  gstStateCode         String?
  // How a booking's discount / exchange value relate to the vehicle's taxable value. CA decisions:
  // null = not decided, and a GST invoice that carries the corresponding amount is refused.
  gstDiscountTreatment GstAdjustmentTreatment?
  gstExchangeTreatment GstAdjustmentTreatment?

  // Document prefixes
  invoicePrefix   String @default("INV")
  bookingPrefix   String @default("BK")
  quotationPrefix String @default("QT")
  receiptPrefix   String @default("RC")
  jobCardPrefix   String @default("JC")
  warrantyPrefix  String @default("WR")
  amcPrefix       String @default("AMC")
  claimPrefix     String @default("CLM")

  // Sales / Service
  defaultWarrantyMonths Int @default(36)
  serviceReminderDays   Int @default(90)

  // Warranty & AMC (Module 8)
  warrantyEnabled      Boolean @default(true)
  amcEnabled           Boolean @default(true)
  warrantyReminderDays Int     @default(30)

  // Finance (Module 9)
  financeEnabled          Boolean @default(true)
  expensePrefix           String  @default("EXP")
  vendorPrefix            String  @default("VND")
  incomePrefix            String  @default("INC")
  bankPrefix              String  @default("BNK")
  returnPrefix            String  @default("RET")
  creditNotePrefix        String  @default("CN")
  refundPrefix            String  @default("RF")
  financeGstRate          Decimal @default(18) @db.Decimal(5, 2)
  financialYearStartMonth Int     @default(4)
  openingCash             BigInt  @default(0)
  openingBank             BigInt  @default(0)
  lowCashThreshold        BigInt  @default(500000)
  largeExpenseThreshold   BigInt  @default(5000000)
  // Free-service intervals (km / days) — configurable per company
  freeService1Km          Int     @default(500)
  freeService1Days        Int     @default(30)
  freeService2Km          Int     @default(3000)
  freeService2Days        Int     @default(90)
  freeService3Km          Int     @default(6000)
  freeService3Days        Int     @default(180)

  // Branding
  companyLogo    String?
  favicon        String?
  primaryColor   String  @default("#0B2545")
  secondaryColor String  @default("#00B8A9")

  // Business hours
  workingDays  String[] @default(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"])
  workingHours String   @default("10:00-19:00")

  // Notifications — per-category in-app toggles (channels below are future-ready)
  notifyDelivery       Boolean @default(true)
  notifyPayment        Boolean @default(true)
  notifyService        Boolean @default(true)
  notifyInventory      Boolean @default(true)
  notifyWarranty       Boolean @default(true)
  desktopNotifications Boolean @default(true)
  emailEnabled         Boolean @default(false)
  smsEnabled           Boolean @default(false)
  whatsappEnabled      Boolean @default(false)

  // Backup
  backupEnabled   Boolean         @default(false)
  backupFrequency BackupFrequency @default(WEEKLY)

  // Invoice
  termsAndConditions String?
  invoiceFooter      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-company document sequence counters (state, not user-editable settings).
model InvoiceSetting {
  id                   String @id @default(uuid())
  companyId            String @unique @default("")
  nextInvoiceNumber    Int    @default(1)
  nextBookingNumber    Int    @default(1)
  nextQuotationNumber  Int    @default(1)
  nextReceiptNumber    Int    @default(1)
  nextServiceNumber    Int    @default(1)
  nextWarrantyNumber   Int    @default(1)
  nextAmcNumber        Int    @default(1)
  nextClaimNumber      Int    @default(1)
  nextExpenseNumber    Int    @default(1)
  nextVendorNumber     Int    @default(1)
  nextIncomeNumber     Int    @default(1)
  nextBankNumber       Int    @default(1)
  nextReturnNumber     Int    @default(1)
  nextCreditNoteNumber Int    @default(1)
  nextRefundNumber     Int    @default(1)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────── Vehicle Return (post-delivery sales return) ───────────────────────────

enum ReturnStatus {
  REQUESTED
  INSPECTION
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

/// Where a returned unit goes once the return completes. SCRAP keeps the unit
/// at RETURNED (non-sellable); AVAILABLE / IN_SERVICE re-stock it.
enum ReturnDisposition {
  AVAILABLE
  IN_SERVICE
  SCRAP
}

/// A post-delivery sales return. Separate from booking cancellation — the original
/// Booking/Sale/Payment records are never mutated. Financial reversal is carried by
/// the linked CreditNote (invoice/GST reversal) and Refund (money returned).
model VehicleReturn {
  id           String        @id @default(uuid())
  companyId    String        @default("")
  returnNumber String
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  bookingId    String
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  unitId       String
  unit         InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  status ReturnStatus @default(REQUESTED)
  reason String

  requestedById String
  requestedAt   DateTime @default(now())

  inspectionOk    Boolean?
  inspectionNotes String?
  inspectedById   String?
  inspectedAt     DateTime?

  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?

  disposition     ReturnDisposition?
  /// Approved deduction (damage/use) withheld from the refund — must carry a reason.
  deductionAmount BigInt             @default(0)
  deductionReason String?
  completedById   String?
  completedAt     DateTime?

  creditNote CreditNote?
  refunds    Refund[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, returnNumber])
  @@index([companyId])
  @@index([saleId])
  @@index([unitId])
  @@index([status])
}

/// Reversal of a sale/invoice (taxable value + GST). Keeps Sale immutable.
model CreditNote {
  id               String        @id @default(uuid())
  companyId        String        @default("")
  creditNoteNumber String
  returnId         String        @unique
  return           VehicleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleId           String
  sale             Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount           BigInt        @default(0)
  gstAmount        BigInt        @default(0)
  total            BigInt        @default(0)
  reason           String
  issuedById       String?
  issuedAt         DateTime      @default(now())

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, creditNoteNumber])
  @@index([companyId])
  @@index([saleId])
}

/// Actual money returned to the customer for a completed return. Never alters the
/// original Payment ledger.
model Refund {
  id           String        @id @default(uuid())
  companyId    String        @default("")
  refundNumber String
  returnId     String
  return       VehicleReturn @relation(fields: [returnId], references: [id], onDelete: Restrict)
  saleId       String
  sale         Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount       BigInt        @default(0)
  method       PaymentMode
  reference    String?
  note         String?
  refundedById String?
  refundedAt   DateTime      @default(now())

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, refundNumber])
  @@index([companyId])
  @@index([returnId])
  @@index([saleId])
}

// ─────────────────────────── Module 8 — Warranty & AMC ───────────────────────────

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CLAIMED
}

enum WarrantyClaimStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum FreeServiceStatus {
  PENDING
  COMPLETED
  MISSED
}

enum AmcPlanType {
  SILVER
  GOLD
  PLATINUM
  CUSTOM
}

enum AmcStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// One warranty per sold vehicle. Coverage is a typed JSON array of line items.
model Warranty {
  id             String         @id @default(uuid())
  companyId      String         @default("")
  warrantyNumber String
  status         WarrantyStatus @default(ACTIVE)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  unitId     String
  unit       InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  bookingId     String?
  saleId        String?
  invoiceNumber String?
  motorNumber   String?
  batteryNumber String?

  purchaseDate DateTime
  startDate    DateTime
  endDate      DateTime
  periodMonths Int

  coverage      Json    @default("[]")
  dealerNotes   String?
  customerNotes String?

  claims       WarrantyClaim[]
  freeServices FreeService[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, warrantyNumber])
  @@index([companyId, status])
  @@index([companyId, endDate])
  @@index([companyId, customerId])
  @@index([unitId])
}

model WarrantyClaim {
  id          String              @id @default(uuid())
  companyId   String              @default("")
  claimNumber String
  status      WarrantyClaimStatus @default(PENDING)

  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  complaint     String
  diagnosis     String?
  partsReplaced Json    @default("[]")
  labour        String?
  technicianId  String?

  claimDate               DateTime  @default(now())
  completionDate          DateTime?
  claimCost               BigInt    @default(0)
  manufacturerClaimAmount BigInt    @default(0)
  dealerCost              BigInt    @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, claimNumber])
  @@index([companyId, status])
  @@index([warrantyId])
  @@index([companyId, claimDate])
}

model FreeService {
  id            String            @id @default(uuid())
  companyId     String            @default("")
  warrantyId    String
  warranty      Warranty          @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  serviceNumber Int
  status        FreeServiceStatus @default(PENDING)
  dueDate       DateTime
  completedDate DateTime?
  technicianId  String?
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warrantyId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model AmcPlan {
  id        String      @id @default(uuid())
  companyId String      @default("")
  amcNumber String
  status    AmcStatus   @default(ACTIVE)
  planType  AmcPlanType @default(SILVER)

  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  unitId     String
  unit       InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  startDate      DateTime
  endDate        DateTime
  visitsIncluded Int      @default(3)
  visitsUsed     Int      @default(0)
  price          BigInt   @default(0)
  notes          String?

  visits AmcVisit[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, amcNumber])
  @@index([companyId, status])
  @@index([companyId, endDate])
  @@index([companyId, customerId])
  @@index([unitId])
}

model AmcVisit {
  id              String   @id @default(uuid())
  companyId       String   @default("")
  amcPlanId       String
  amcPlan         AmcPlan  @relation(fields: [amcPlanId], references: [id], onDelete: Cascade)
  visitNumber     Int
  visitDate       DateTime @default(now())
  technicianId    String?
  workDone        String
  partsUsed       String?
  amount          BigInt   @default(0)
  coveredUnderAmc Boolean  @default(true)

  createdById String?
  createdAt   DateTime @default(now())

  @@unique([amcPlanId, visitNumber])
  @@index([amcPlanId])
  @@index([companyId, visitDate])
}

// ─────────────────────────── Module 9 — Finance & Expense ───────────────────────────

enum ExpenseStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseAttachmentType {
  INVOICE
  GST_BILL
  PHOTO
  PDF
  OTHER
}

enum BankReconStatus {
  PENDING
  CLEARED
  RECONCILED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum FinancePayMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
}

enum IncomeSource {
  ACCESSORIES
  INSURANCE_COMMISSION
  FINANCE_COMMISSION
  REGISTRATION
  SERVICE
  AMC
  WARRANTY_RECOVERY
  OTHER
}

enum BankTxnType {
  DEPOSIT
  WITHDRAWAL
  NEFT
  RTGS
  IMPS
  CHEQUE
  UPI
}

enum BankDirection {
  CREDIT
  DEBIT
}

model ExpenseCategory {
  id        String  @id @default(uuid())
  companyId String  @default("")
  name      String
  isSystem  Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  expenses  Expense[]
  recurring RecurringExpense[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId, active])
}

model Vendor {
  id           String       @id @default(uuid())
  companyId    String       @default("")
  vendorNumber String
  name         String
  mobile       String?
  email        String?
  gstNumber    String?
  address      String?
  city         String?
  state        String?
  status       VendorStatus @default(ACTIVE)
  notes        String?

  expenses           Expense[]
  recurring          RecurringExpense[]
  accessoryPurchases AccessoryPurchase[]

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, vendorNumber])
  @@index([companyId, status])
  @@index([companyId, name])
  @@index([deletedAt])
}

model Expense {
  id            String   @id @default(uuid())
  companyId     String   @default("")
  expenseNumber String
  expenseDate   DateTime @default(now())

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId   String?
  vendor     Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  amount          BigInt           @default(0)
  gstAmount       BigInt           @default(0)
  paymentMethod   FinancePayMethod @default(CASH)
  referenceNumber String?
  description     String?
  attachmentKey   String?
  status          ExpenseStatus    @default(APPROVED)
  paid            Boolean          @default(true)
  dueDate         DateTime?
  settledDate     DateTime?

  attachments ExpenseAttachment[]

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([companyId, expenseNumber])
  @@index([companyId, status])
  @@index([companyId, expenseDate])
  @@index([companyId, categoryId])
  @@index([companyId, vendorId])
  @@index([companyId, paymentMethod])
  @@index([referenceNumber])
  @@index([deletedAt])
}

model Income {
  id           String       @id @default(uuid())
  companyId    String       @default("")
  incomeNumber String
  incomeDate   DateTime     @default(now())
  source       IncomeSource @default(OTHER)

  amount          BigInt           @default(0)
  gstAmount       BigInt           @default(0)
  paymentMethod   FinancePayMethod @default(CASH)
  referenceNumber String?
  description     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, incomeNumber])
  @@index([companyId, source])
  @@index([companyId, incomeDate])
  @@index([referenceNumber])
}

model BankTransaction {
  id          String          @id @default(uuid())
  companyId   String          @default("")
  txnNumber   String
  txnDate     DateTime        @default(now())
  type        BankTxnType
  direction   BankDirection
  amount      BigInt          @default(0)
  bankName    String?
  reference   String?
  notes       String?
  reconStatus BankReconStatus @default(PENDING)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, txnNumber])
  @@index([companyId, txnDate])
  @@index([companyId, type])
  @@index([reference])
}

/// Manual cash-book corrections (signed paise: + adds cash, − removes cash).
model CashAdjustment {
  id        String   @id @default(uuid())
  companyId String   @default("")
  adjDate   DateTime @default(now())
  amount    BigInt
  notes     String

  createdById String?
  createdAt   DateTime @default(now())

  @@index([companyId, adjDate])
}

model ExpenseAttachment {
  id        String                @id @default(uuid())
  companyId String                @default("")
  expenseId String
  expense   Expense               @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  type      ExpenseAttachmentType @default(OTHER)
  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int

  createdById String?
  createdAt   DateTime @default(now())

  @@index([expenseId])
  @@index([companyId])
}

/// A template that auto-generates a monthly expense (rent, salary, subscriptions…).
model RecurringExpense {
  id            String           @id @default(uuid())
  companyId     String           @default("")
  name          String
  categoryId    String
  category      ExpenseCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  vendorId      String?
  vendor        Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  amount        BigInt           @default(0)
  gstAmount     BigInt           @default(0)
  paymentMethod FinancePayMethod @default(BANK_TRANSFER)
  dayOfMonth    Int              @default(1)
  description   String?
  active        Boolean          @default(true)
  lastRunYear   Int?
  lastRunMonth  Int?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, active])
}

/// A locked accounting month — finance transactions dated inside it become read-only.
model MonthlyClosing {
  id        String   @id @default(uuid())
  companyId String   @default("")
  year      Int
  month     Int
  notes     String?
  closedAt  DateTime @default(now())

  closedById String?
  createdAt  DateTime @default(now())

  @@unique([companyId, year, month])
  @@index([companyId, year, month])
}

// ─────────────────────────── GST / Tax management (Stage A: config/master data only) ───────────────────────────
// Reusable tax classification + effective-dated rate master. No calculation, Booking/Sale, invoice,
// or Delivery behavior depends on these yet — they are configuration consumed by a future tax engine.

enum TaxCodeType {
  HSN
  SAC
}

enum TaxTreatment {
  TAXABLE
  EXEMPT
  NON_TAXABLE
  NIL_RATED
}

/// A tax classification (an HSN for goods or SAC for services) with its treatment. Company-scoped.
model TaxClassification {
  id          String       @id @default(uuid())
  companyId   String       @default("")
  name        String
  codeType    TaxCodeType
  /// The HSN/SAC code. Required for TAXABLE; optional otherwise.
  code        String?
  treatment   TaxTreatment @default(TAXABLE)
  description String?
  isActive    Boolean      @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  rates             TaxRate[]
  scooterModels     ScooterModel[]
  accessories       Accessory[]
  componentMappings TaxComponentMapping[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// A single combined GST rate for a classification, effective over a date range. The CGST/SGST/IGST
/// split is NOT stored here — the future engine derives it per transaction from place of supply.
model TaxRate {
  id               String            @id @default(uuid())
  companyId        String            @default("")
  classificationId String
  classification   TaxClassification @relation(fields: [classificationId], references: [id], onDelete: Cascade)
  ratePercent      Decimal           @db.Decimal(5, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  isActive         Boolean           @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([classificationId, effectiveFrom])
}

// ─────────────────────────── GST on sales (Stage C: immutable tax snapshots) ───────────────────────────

/// How a commercial adjustment (discount / exchange value) relates to the vehicle's taxable value.
/// Which one applies is a CA decision recorded in CompanySetting — never defaulted.
enum GstAdjustmentTreatment {
  /// Deducted from the vehicle line before GST is extracted.
  REDUCES_VEHICLE_TAXABLE_VALUE
  /// Leaves every taxable value untouched; only reduces the amount payable.
  AFTER_TAX_ADJUSTMENT
}

enum TaxSupplyType {
  INTRA
  INTER
}

enum TaxPricingMode {
  INCLUSIVE
  EXCLUSIVE
}

/// What a snapshot line represents.
enum TaxLineComponent {
  VEHICLE
  ACCESSORY
  EXTENDED_WARRANTY
  RTO
  INSURANCE
  REGISTRATION
}

/// Booking components that have no product/service master of their own and are classified by mapping.
enum TaxMappedComponent {
  EXTENDED_WARRANTY
  RTO
  INSURANCE
  REGISTRATION
}

/// Per-company GST classification for a scalar booking component. Config — no row is ever created
/// automatically; a missing mapping makes a GST invoice carrying that component fail closed.
model TaxComponentMapping {
  id               String             @id @default(uuid())
  companyId        String             @default("")
  componentType    TaxMappedComponent
  classificationId String
  classification   TaxClassification  @relation(fields: [classificationId], references: [id], onDelete: Restrict)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, componentType])
  @@index([companyId])
}

/// The GST calculated for one sale, frozen at invoice time. IMMUTABLE: never updated, never
/// soft-deleted, and never recalculated — later changes to classifications, rates, products,
/// customers or company settings must not alter it. Present only for sales invoiced with GST enabled.
model TaxSnapshot {
  id        String @id @default(uuid())
  companyId String @default("")
  saleId    String @unique
  sale      Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  engineVersion          String
  /// The tax-point calendar date the rates were resolved for.
  asOf                   DateTime      @db.Date
  supplyType             TaxSupplyType
  supplierGstin          String
  supplierStateCode      String
  placeOfSupplyStateCode String

  /// The policy actually applied (null when the booking carried no such amount).
  discountTreatment GstAdjustmentTreatment?
  exchangeTreatment GstAdjustmentTreatment?
  discountAmount    BigInt                  @default(0)
  exchangeAmount    BigInt                  @default(0)

  // Sums of the line results (never recomputed from the document total).
  totalGross    BigInt
  totalTaxable  BigInt
  totalCGST     BigInt
  totalSGST     BigInt
  totalIGST     BigInt
  totalTax      BigInt
  totalRoundOff BigInt
  /// The customer-facing total this snapshot reconciles to — always equal to Sale.total.
  documentTotal BigInt

  createdById String?
  createdAt   DateTime @default(now())

  lines TaxSnapshotLine[]

  @@index([companyId])
  @@index([companyId, asOf])
}

/// One calculated line of a TaxSnapshot. IMMUTABLE. The classification fields are COPIED values and
/// are the historical truth; classificationId is reference metadata only (deliberately not a relation).
model TaxSnapshotLine {
  id         String      @id @default(uuid())
  companyId  String      @default("")
  snapshotId String
  snapshot   TaxSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  lineKey       String
  position      Int
  componentType TaxLineComponent
  description   String
  /// Identifier of the originating record, when there is one (e.g. the accessory id). Not a relation.
  sourceId      String?
  quantity      Int              @default(1)
  unitAmount    BigInt

  classificationId   String
  classificationName String
  codeType           TaxCodeType
  code               String?
  treatment          TaxTreatment
  ratePercent        Decimal?       @db.Decimal(5, 2)
  pricingMode        TaxPricingMode

  grossAmount   BigInt
  taxableAmount BigInt
  cgst          BigInt
  sgst          BigInt
  igst          BigInt
  taxTotal      BigInt
  roundOff      BigInt

  createdAt DateTime @default(now())

  @@unique([snapshotId, lineKey])
  @@unique([snapshotId, position])
  @@index([companyId])
}
