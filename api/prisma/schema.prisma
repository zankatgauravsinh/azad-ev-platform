model DeliveryPhoto {
  id         String   @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  fileKey    String
  label      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deliveryId])
}

// ─────────────────────────── Service ───────────────────────────

model ServiceJob {
  id               String          @id @default(uuid())
  companyId        String          @default("")
  code             String          @unique
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  unitId           String
  unit             InventoryUnit   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  bookingId        String?
  booking          Booking?        @relation(fields: [bookingId], references: [id])
  saleId           String?
  sale             Sale?           @relation(fields: [saleId], references: [id])
  technicianId     String?
  technician       User?           @relation("ServiceJobTechnician", fields: [technicianId], references: [id])
  type             ServiceJobType  @default(PAID)
  priority         ServicePriority @default(MEDIUM)
  status           ServiceStatus   @default(BOOKED)
  odometerKm       Int?
  scheduledDate    DateTime?
  checkInAt        DateTime?
  checkOutAt       DateTime?
  expectedDelivery DateTime?
  actualDelivery   DateTime?
  notes            String?
  underWarranty    Boolean         @default(false)

  partsTotal  BigInt @default(0)
  labourTotal BigInt @default(0)
  discount    BigInt @default(0)
  taxAmount   BigInt @default(0)
  total       BigInt @default(0)

  feedbackRating Int?
  feedbackNote   String?

  closedAt    DateTime?
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  complaints ServiceComplaint[]
  inspection ServiceInspectionItem[]
  parts      ServicePart[]
  labour     ServiceLabour[]
  photos     ServiceJobPhoto[]
  payments   Payment[]

  @@index([status])
  @@index([customerId])
  @@index([unitId])
  @@index([technicianId])
  @@index([scheduledDate])
  @@index([deletedAt])
  @@index([companyId])
}

model ServiceComplaint {
  id           String          @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob      @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  description  String
  priority     ServicePriority @default(MEDIUM)
  resolved     Boolean         @default(false)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceJobId])
}

model ServiceInspectionItem {
  id           String           @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob       @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  item         String
  result       InspectionResult @default(GOOD)
  notes        String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceJobId, item])
  @@index([serviceJobId])
}

model ServicePart {
  id           String     @id @default(uuid())
  serviceJobId String
  serviceJob   ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)
  sparePartId  String?
  sparePart    SparePart? @relation(fields: [sparePartId], references: [id])
  name         String
  qty          Int        @default(1)
  unitCost     BigInt     @default(0)
  unitPrice    BigInt     @default(0)
  warranty     Boolean    @default(false)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
