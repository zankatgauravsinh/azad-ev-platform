# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://azad:azad@localhost:5432/azad_ev?schema=public"

# ── API ───────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development

# ── Auth (JWT) ────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-in-production"
JWT_REFRESH_TTL="7d"

# ── Storage (local now, S3-ready) ─────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./uploads"
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=

# ── CORS ──────────────────────────────────────────────────
WEB_ORIGIN="http://localhost:5173"

# ── Seed (initial owner account) ──────────────────────────
SEED_OWNER_EMAIL="owner@azadev.in"
SEED_OWNER_PASSWORD="Azad@12345"

# ── Frontend (Vite) ───────────────────────────────────────
VITE_API_BASE_URL="http://localhost:3000/api/v1"
